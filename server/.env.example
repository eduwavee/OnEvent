# Base de datos (coincide con docker-compose.yml de la raíz)
DATABASE_URL="postgresql://eventos:eventos@localhost:5432/gestion_eventos?schema=public"

# Servidor
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Email (opcional). Si se dejan vacías, las notificaciones solo se loguean en consola.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestion de Eventos <no-reply@eventos.local>"
