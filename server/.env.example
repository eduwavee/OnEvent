# Base de datos: SQLite, se crea como archivo local (server/prisma/dev.db) sin
# necesidad de instalar ni levantar ningún servidor de base de datos.
DATABASE_URL="file:./dev.db"

# Servidor
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Email (opcional). Si se dejan vacías, las notificaciones solo se loguean en consola.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestion de Eventos <no-reply@eventos.local>"

# Cuenta admin inicial creada por `npm run prisma:seed` (opcional: valores
# por defecto abajo si no se configuran).
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@eventos.local"
ADMIN_PASSWORD="admin123"
